    "LOSO-Template-Supported": {
      "requires_all_target_tokens_in_training": true,
      "requires_exact_template_in_training": true,
      "rule": "Held-out recordings whose exact sentence_id occurs at least once in the LOSO training partition."
    },
    "LOSO-Token-Supported": {
      "requires_all_target_tokens_in_training": true,
      "requires_exact_template_in_training": false,
      "rule": "Held-out recordings for which every target gloss token occurs in at least one template in the LOSO training partition."
    },
    "Token-Supported-Novel-Template": {
      "primary_report_subset": false,
      "rule": "Diagnostic subset of LOSO-Token-Supported where the exact sentence_id is absent from training."
    },
    "Token-Unsupported": {
      "primary_report_subset": false,
      "rule": "Diagnostic subset containing at least one target gloss token with zero training support in that LOSO run."
    }
  },
